<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#1b6b86">
<title>Household status</title>
<style>
:root{--bg:#f6f1ec;--card:#fffdfa;--text:#2b2220;--mute:#7a6b66;--line:#eadfd8;--accent:#b4456b;--ink:#fff;
--green:#3f9e6a;--red:#d9534f;--amber:#e0a030;--blue:#4a86d6;--purple:#8a62c9;--gray:#a39792;
--shadow:0 1px 2px rgba(60,35,25,.06),0 8px 20px rgba(60,35,25,.07)}
@media (prefers-color-scheme:dark){:root{--bg:#1c1614;--card:#271f1c;--text:#f6ece6;--mute:#b7a59d;--line:#3a2e29;--accent:#e27a9b;--ink:#2b1018;--shadow:none}}
*{box-sizing:border-box}
html{background:var(--page,var(--bg));background-attachment:fixed;min-height:100%}
body{margin:0;color:var(--text);font:16px/1.45 ui-rounded,"SF Pro Rounded",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
padding:max(20px,env(safe-area-inset-top)) 16px max(24px,env(safe-area-inset-bottom));max-width:560px;margin:0 auto}
h1{font-size:30px;line-height:1.15;margin:8px 4px 20px;font-weight:700;letter-spacing:-.01em}
.card{background:var(--card);border-radius:22px;padding:18px;margin-bottom:14px;box-shadow:var(--shadow)}
.label{font-size:15px;color:var(--mute);margin-bottom:12px;font-weight:600}
.chips{display:flex;flex-wrap:wrap;gap:8px}
button{font:inherit;cursor:pointer}
button:focus-visible,input:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
.chip{border:0;background:var(--bg);color:var(--text);border-radius:999px;padding:11px 16px;font-size:15px;font-weight:500}
.chip.on{font-weight:600}
.chip.sel{box-shadow:0 0 0 2px var(--text) inset}
.hint{font-size:13px;color:var(--mute);margin-top:10px}
input{width:100%;margin-top:12px;padding:13px 14px;border-radius:14px;border:1.5px solid var(--line);background:var(--bg);color:var(--text);font:inherit}
.go{margin-top:14px;background:var(--accent);color:var(--ink);border:0;border-radius:14px;padding:13px 22px;font-size:16px;font-weight:600}
.person{display:flex;align-items:center;gap:14px;padding:12px 0}
.person+.person{border-top:1px solid var(--line)}
.av{width:46px;height:46px;border-radius:50%;flex:none;display:grid;place-items:center;font-weight:700;font-size:18px;border:3px solid var(--gray);background:var(--bg)}
.pname{font-weight:650;font-size:17px}.pstat{font-size:14px;color:var(--mute)}
.me{font-size:12px;color:var(--accent);margin-left:8px;font-weight:600}
.ask-btn{margin-left:auto;border:0;background:var(--bg);color:var(--accent);border-radius:999px;padding:9px 14px;font-size:14px;font-weight:600;flex:none}
.ask-btn:disabled{opacity:.55;cursor:default}
.ask{position:sticky;top:10px;z-index:5;background:var(--accent);color:var(--ink);border-radius:22px;padding:18px;margin-bottom:14px;box-shadow:0 10px 30px rgba(180,69,107,.35)}
.ask b{display:block;margin-bottom:12px;font-size:18px}
.btns{display:flex;flex-wrap:wrap;gap:8px}
.ask button{border:0;border-radius:14px;padding:11px 15px;font-size:15px;font-weight:600;background:var(--ink);color:var(--accent)}
.ask button.alt{background:transparent;color:var(--ink);border:1.5px solid currentColor}
@media (prefers-reduced-motion:no-preference){.ask{animation:ring 1.6s ease-out infinite}
@keyframes ring{0%{box-shadow:0 0 0 0 rgba(226,122,155,.7)}70%{box-shadow:0 0 0 18px rgba(226,122,155,0)}100%{box-shadow:0 0 0 0 rgba(226,122,155,0)}}}
.reply{background:var(--card);border-radius:18px;padding:14px 16px;margin-bottom:14px;box-shadow:var(--shadow)}
.fi{padding:11px 0}.fi+.fi{border-top:1px solid var(--line)}
.fi small{display:block;color:var(--mute);font-size:13px;margin-top:2px}
.note{color:var(--mute);font-size:14px;text-align:center;padding:10px}
.foot{display:flex;justify-content:center;flex-wrap:wrap;gap:4px}
.link{background:none;border:0;color:var(--mute);font-size:14px;text-decoration:underline;padding:10px}
:root[data-status="free"]{--page:linear-gradient(165deg,#e8fbf1,#c3eed8);--bg:#d3f1e2;--card:#f8fffb;--text:#12332a;--mute:#4b7366;--line:#bfe6d3;--accent:#1f8a63;--ink:#fff;--shadow:0 1px 2px rgba(20,80,55,.08),0 8px 20px rgba(20,80,55,.08)}
:root[data-status="meeting"]{--page:#f6f1ec;--bg:#f6f1ec;--card:#fffdfa;--text:#2b2220;--mute:#7a6b66;--line:#eadfd8;--accent:#b4456b;--ink:#fff;--shadow:0 1px 2px rgba(60,35,25,.06),0 8px 20px rgba(60,35,25,.07)}
:root[data-status="call"]{--page:linear-gradient(165deg,#ffeab8,#ffc86a);--bg:#ffe2a0;--card:#fffaf0;--text:#3a2606;--mute:#7d5f2a;--line:#f2d28a;--accent:#b85f06;--ink:#fff;--shadow:0 1px 2px rgba(120,70,0,.08),0 8px 20px rgba(120,70,0,.1)}
:root[data-status="off"]{--page:linear-gradient(180deg,#16356b 0%,#0a1630 55%,#000 100%);--bg:#0c1730;--card:#101c36;--text:#e8eefc;--mute:#93a4c8;--line:#22345c;--accent:#7fa8ff;--ink:#0a1630;--shadow:none}
[hidden]{display:none!important}
</style>
</head>
<body>
<h1 id="title">Household status</h1>
<div id="setupMsg" class="card" hidden>Firebase isn’t set up yet. Paste your Firebase config into <code>index.html</code> (see the <code>firebaseConfig</code> block), then reload.</div>
<div id="join" class="card" hidden>
  <div class="label">Join your household</div>
  <input id="houseIn" placeholder="House code (shared by your household)" maxlength="60" autocomplete="off">
  <input id="nameIn" placeholder="Your name" maxlength="30">
  <button class="go" id="joinBtn">Join</button>
</div>
<div id="app" hidden>
  <div id="inbox"></div>
  <div class="card">
    <div class="label">My status</div>
    <div class="chips" id="chips"></div>
    <input id="noteIn" placeholder="Note (optional), e.g. back at 3pm" maxlength="60">
    <button class="go" id="setBtn">Set status</button>
    <div class="hint">Pick a status, add a note if you like, then press Enter.</div>
  </div>
  <div class="card"><div class="label">Everyone</div><div id="list"><div class="note">Loading…</div></div></div>
  <div class="card"><div class="label">Recent changes</div><div id="feed"><div class="note">Loading…</div></div></div>
  <div class="foot"><button class="link" id="sndBtn"></button><button class="link" id="ntfBtn">Turn on alerts</button><button class="link" id="leave">Switch name or house</button></div>
</div>

<script type="module">
import {initializeApp} from "https://www.gstatic.com/firebasejs/10.14.1/firebase-app.js";
import {getFirestore,collection,doc,setDoc,onSnapshot,query,orderBy,limit} from "https://www.gstatic.com/firebasejs/10.14.1/firebase-firestore.js";

// 1) Paste your Firebase web app config here (Project settings > Your apps > Web app).
const firebaseConfig = {
  apiKey: "AIzaSyASRTEsWZVTSebZ8p4SCf0onDPDyY2cSjI",
  authDomain: "family-hub-e2995.firebaseapp.com",
  projectId: "family-hub-e2995",
  storageBucket: "family-hub-e2995.firebasestorage.app",
  messagingSenderId: "960242386059",
  appId: "1:960242386059:web:48e1ec58eaf53c6286808e"
};

const $=id=>document.getElementById(id);
const STATUSES=[
 {k:"free",t:"Available",c:"#2fbf8a",fg:"#fff"},{k:"meeting",t:"In a meeting",c:"#b4456b",fg:"#fff"},
 {k:"call",t:"On a call",c:"#f0a020",fg:"#2b1a00"},{k:"off",t:"Off",c:"#2c4a8f",fg:"#fff"}];
const norm=k=>k==="out"?"off":k;
const S=k=>STATUSES.find(s=>s.k===norm(k))||{t:"No status",c:"#a39792",fg:"#fff"};
const slug=n=>n.trim().toLowerCase().replace(/[^a-z0-9]+/g,"-").replace(/^-|-$/g,"")||"x";
const rid=p=>p+Date.now().toString(36)+Math.random().toString(36).slice(2,6);
const get=k=>{try{return localStorage.getItem(k)||""}catch(e){return ""}};
const put=(k,v)=>{try{localStorage.setItem(k,v)}catch(e){}};

let actx;const unlock=()=>{try{actx=actx||new (window.AudioContext||window.webkitAudioContext)();if(actx.state==="suspended")actx.resume()}catch(e){}};
document.addEventListener("pointerdown",unlock);
const soundOn=()=>get("hs_sound")!=="off";
function chime(){if(!soundOn()||!actx)return;try{[[880,0],[1175,.18],[880,.42]].forEach(([f,t])=>{const o=actx.createOscillator(),g=actx.createGain();o.type="sine";o.frequency.value=f;
 g.gain.setValueAtTime(0,actx.currentTime+t);g.gain.linearRampToValueAtTime(.25,actx.currentTime+t+.02);g.gain.exponentialRampToValueAtTime(.001,actx.currentTime+t+.4);
 o.connect(g);g.connect(actx.destination);o.start(actx.currentTime+t);o.stop(actx.currentTime+t+.45)})}catch(e){}}
function wireFoot(){const sb=$("sndBtn"),nb=$("ntfBtn");const paint=()=>{sb.textContent=soundOn()?"Sound on":"Sound off"};paint();
 sb.onclick=()=>{put("hs_sound",soundOn()?"off":"on");unlock();paint();if(soundOn())chime()};
 if(!("Notification" in window)||Notification.permission==="granted")nb.hidden=true;
 nb.onclick=()=>{Notification.requestPermission().then(p=>{if(p==="granted")nb.hidden=true})}}
if(firebaseConfig.apiKey.startsWith("PASTE")){$("setupMsg").hidden=false}
else{
 const db=getFirestore(initializeApp(firebaseConfig));
 let house=get("hs_house"),name=get("hs_name"),me,mine={},knocks=[],first=true,noteTimer,unsubs=[],pending="";

 const col=c=>collection(db,"houses",house,c);
 const dref=(c,id)=>doc(db,"houses",house,c,id);
 const ago=ts=>{if(!ts)return"";const m=Math.round((Date.now()-ts)/6e4);if(m<1)return"just now";if(m<60)return m+"m ago";const h=Math.round(m/60);return h<24?h+"h ago":Math.round(h/24)+"d ago"};
 const fmt=ts=>{if(!ts)return"";const d=new Date(ts),n=new Date(),t=d.toLocaleTimeString([],{hour:"numeric",minute:"2-digit"});
  if(d.toDateString()===n.toDateString())return"Today "+t;
  const y=new Date(n);y.setDate(n.getDate()-1);if(d.toDateString()===y.toDateString())return"Yesterday "+t;
  return d.toLocaleDateString([],{month:"short",day:"numeric"})+" "+t};

 const save=patch=>{mine={...mine,...patch,name,updatedAt:Date.now()};setDoc(dref("status",me),mine).catch(()=>{})};
 const post=text=>setDoc(dref("feed",rid("f")),{name,text,at:Date.now()}).catch(()=>{});
 const knock=(toId,toName)=>{setDoc(dref("knocks",rid("k")),{to:toId,toName,from:me,fromName:name,at:Date.now(),status:"pending"}).catch(()=>{});post("asked "+toName+" for a moment")};
 const respond=(k,status)=>{setDoc(dref("knocks",k.id),{...k.d,status,respondedAt:Date.now()}).catch(()=>{});
  post("replied to "+k.d.fromName+": "+{come:"come in",wait:"give me 5 min",no:"not now"}[status])};

 function applyTheme(){document.documentElement.dataset.status=norm(mine.status||"")}
 function renderChips(){const b=$("chips");b.textContent="";const cur=norm(pending||mine.status||"");
  STATUSES.forEach(s=>{const x=document.createElement("button");const on=norm(mine.status||"")===s.k;
   x.className="chip"+(on?" on":"")+(cur===s.k&&!on?" sel":"");x.textContent=s.t;
   if(on){x.style.background=s.c;x.style.color=s.fg}
   x.onclick=()=>{pending=s.k;renderChips()};b.appendChild(x)});applyTheme()}

 // Fixed: renamed function from pending to isPending to avoid naming collision with `let pending`
 const isPending=id=>knocks.some(k=>k.d.from===me&&k.d.to===id&&k.d.status==="pending"&&Date.now()-k.d.at<72e5);

 function renderList(docs){const l=$("list");l.textContent="";
  if(!docs.length){l.innerHTML='<div class="note">No one has checked in yet.</div>';return}
  docs.sort((a,b)=>(a.d.name||"").localeCompare(b.d.name||"")).forEach(({id,d})=>{
   const s=S(d.status),r=document.createElement("div");r.className="person";
   const dot=document.createElement("span");dot.className="av";dot.textContent=((d.name||"?").trim()[0]||"?").toUpperCase();dot.style.borderColor=s.c;
   const w=document.createElement("div"),n=document.createElement("div");n.className="pname";n.textContent=d.name||"Someone";
   if(id===me){const m=document.createElement("span");m.className="me";m.textContent="you";n.appendChild(m)}
   const st=document.createElement("div");st.className="pstat";st.textContent=[s.t,d.note,ago(d.updatedAt)].filter(Boolean).join(" · ");
   w.append(n,st);r.append(dot,w);
   if(id!==me){const b=document.createElement("button"),sent=isPending(id);b.className="ask-btn";b.textContent=sent?"Asked ✓":"🔔 Ask";b.disabled=sent;
    b.onclick=()=>{b.disabled=true;b.textContent="Asked ✓";knock(id,d.name||"someone")};r.appendChild(b)}
   l.appendChild(r)})}

 function renderInbox(){const box=$("inbox");box.textContent="";const now=Date.now();
  knocks.filter(k=>k.d.to===me&&k.d.status==="pending"&&now-k.d.at<72e5).forEach(k=>{
   const a=document.createElement("div");a.className="ask";const t=document.createElement("b");
   t.textContent=(k.d.fromName||"Someone")+" would like a moment with you";const bt=document.createElement("div");bt.className="btns";
   [["come","Come in",0],["wait","Give me 5 min",1],["no","Not now",1]].forEach(([s,l,alt])=>{
    const b=document.createElement("button");b.textContent=l;if(alt)b.className="alt";b.onclick=()=>respond(k,s);bt.appendChild(b)});
   a.append(t,bt);box.appendChild(a)});
  knocks.filter(k=>k.d.from===me&&k.d.status!=="pending"&&k.d.respondedAt&&now-k.d.respondedAt<6e5).forEach(k=>{
   const r=document.createElement("div");r.className="reply";
   r.textContent=(k.d.toName||"They")+" "+({come:"said come in",wait:"needs about 5 minutes",no:"can’t right now"}[k.d.status]||"replied");box.appendChild(r)})}

 function renderFeed(items){const f=$("feed");f.textContent="";
  if(!items.length){f.innerHTML='<div class="note">Nothing yet.</div>';return}
  items.forEach(it=>{const d=document.createElement("div");d.className="fi";const b=document.createElement("b");b.textContent=it.name||"Someone";
   d.append(b,document.createTextNode(" "+it.text));const s=document.createElement("small");s.textContent=fmt(it.at)+" · "+ago(it.at);d.appendChild(s);f.appendChild(d)})}

 const notifyAsk=()=>{try{if(document.hidden&&"Notification" in window&&Notification.permission==="granted"){const k=knocks.filter(x=>x.d.to===me&&x.d.status==="pending").sort((a,b)=>a.d.at-b.d.at).pop();new Notification((k?k.d.fromName:"Someone")+" is asking for a moment",{body:"Open the household board to reply."})}}catch(e){}};
 let lastDocs=[],lastFeed=[];
 function start(){
  me=slug(name);$("join").hidden=true;$("app").hidden=false;$("title").textContent="Hi, "+name;wireFoot();
  const commit=()=>{const st=norm(pending||mine.status||"free"),note=$("noteIn").value.trim();
   const ch=st!==norm(mine.status||""),nc=note!==(mine.note||"");if(!ch&&!nc)return;
   save({status:st,note});
   if(ch)post("is now "+S(st).t.toLowerCase()+(note?": “"+note+"”":""));
   else post(note?"updated their note: “"+note+"”":"cleared their note");
   pending="";renderChips();const b=$("setBtn");b.textContent="Set ✓";setTimeout(()=>b.textContent="Set status",1500)};
  $("setBtn").onclick=commit;
  $("noteIn").onkeydown=e=>{if(e.key==="Enter"){e.preventDefault();commit()}};
  unsubs.push(onSnapshot(col("status"),snap=>{
   lastDocs=snap.docs.map(d=>({id:d.id,d:d.data()}));const m=lastDocs.find(x=>x.id===me);
   if(m&&!Object.keys(mine).length){mine=m.d;$("noteIn").value=mine.note||"";pending=norm(mine.status||"")}
   if(!m&&!Object.keys(mine).length){save({status:"free"})}
   renderChips();renderList(lastDocs.slice())},()=>{$("list").innerHTML='<div class="note">Couldn’t load. Check your Firebase rules and config.</div>'}));
  unsubs.push(onSnapshot(col("knocks"),snap=>{
   knocks=snap.docs.map(d=>({id:d.id,d:d.data()}));
   if(!first&&snap.docChanges().some(c=>c.type==="added"&&c.doc.data().to===me&&c.doc.data().status==="pending")){
    chime();try{navigator.vibrate&&navigator.vibrate([200,100,200])}catch(e){}notifyAsk();const t=document.title;document.title="🔔 Someone’s asking";setTimeout(()=>document.title=t,8000)}
   first=false;renderInbox();renderList(lastDocs.slice())},()=>{}));
  unsubs.push(onSnapshot(query(col("feed"),orderBy("at","desc"),limit(40)),snap=>{lastFeed=snap.docs.map(d=>d.data());renderFeed(lastFeed)},()=>{}));
  setInterval(()=>{renderInbox();renderFeed(lastFeed)},3e4);
 }

 $("joinBtn").onclick=()=>{const h=$("houseIn").value.trim(),n=$("nameIn").value.trim();
  if(h.length<8){alert("Use a house code with at least 8 characters.");return}if(!n)return;
  put("hs_house",h);put("hs_name",n);house=h;name=n;start()};
 $("leave").onclick=()=>{put("hs_house","");put("hs_name","");location.reload()};
 if(house&&name)start();else $("join").hidden=false;
}
</script>
</body>
</html>
